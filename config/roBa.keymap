#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// ==========================================================
// トラックボール設定
// ==========================================================

&trackball { scroll-layers = <4>; };

// ==========================================================
// グローバル設定の最適化
// ==========================================================

&mt {
    flavor = "balanced";            
    tapping-term-ms = <200>;        
    quick-tap-ms = <175>;           
    require-prior-idle-ms = <35>;  
    retro-tap;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&kscan0 { debounce-period = <10>; };

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };

        copy_combo {
            bindings = <&kp LC(C)>;
            key-positions = <22 24>; 
        };

        paste_combo {
            bindings = <&kp LC(V)>;
            key-positions = <22 25>; 
        };

        cut_combo {
            bindings = <&kp LC(X)>;
            key-positions = <22 23>; 
        };

        select_all_combo {
            bindings = <&kp LC(A)>;
            key-positions = <10 22>; 
        };

        save_combo {
            bindings = <&kp LC(S)>;
            key-positions = <11 22>; 
        };

        search_combo {
            bindings = <&kp LC(F)>;
            key-positions = <22 27>; 
        };

        replace_combo {
            bindings = <&kp LC(H)>;
            key-positions = <17 22>; 
        };

        print_combo {
            bindings = <&kp LC(P)>;
            key-positions = <9 22>;  
        };

        bold_combo {
            bindings = <&kp LC(B)>;
            key-positions = <22 26>; 
        };

        italic_combo {
            bindings = <&kp LC(I)>;
            key-positions = <7 22>;  
        };

        underline_combo {
            bindings = <&kp LC(U)>;
            key-positions = <6 22>;  
        };

        close_tab_combo {
            bindings = <&kp LC(W)>;
            key-positions = <1 22>;  
        };

        new_window_combo {
            bindings = <&kp LC(N)>;
            key-positions = <22 29>; 
        };

        new_page_combo {
            bindings = <&kp LC(M)>;
            key-positions = <22 30>; 
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        ga_macro: ga_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp T &kp LEFT_BRACKET>;
            label = "GA_MACRO";
        };

        pa_macro: pa_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp RIGHT_BRACKET>;
            label = "PA_MACRO";
        };

        zu_macro: zu_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp R &kp LEFT_BRACKET>;
            label = "ZU_MACRO";
        };

        de_macro: de_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp W &kp LEFT_BRACKET>;
            label = "DE_MACRO";
        };

        da_macro: da_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Q &kp LEFT_BRACKET>;
            label = "DA_MACRO";
        };

        do_macro: do_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp S &kp LEFT_BRACKET>;
            label = "DO_MACRO";
        };

        zi_macro: zi_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp D &kp LEFT_BRACKET>;
            label = "ZI_MACRO";
        };

        ba_macro: ba_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp F &kp LEFT_BRACKET>;
            label = "BA_MACRO";
        };

        gi_macro: gi_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp G &kp LEFT_BRACKET>;
            label = "GI_MACRO";
        };

        gu_macro: gu_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp H &kp LEFT_BRACKET>;
            label = "GU_MACRO";
        };

        du_macro: du_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp Z &kp LEFT_BRACKET>;
            label = "DU_MACRO";
        };

        za_macro: za_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp X &kp LEFT_BRACKET>;
            label = "ZA_MACRO";
        };

        zo_macro: zo_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp C &kp LEFT_BRACKET>;
            label = "ZO_MACRO";
        };

        bi_macro: bi_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp LEFT_BRACKET>;
            label = "BI_MACRO";
        };

        go_macro: go_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp B &kp LEFT_BRACKET>;
            label = "GO_MACRO";
        };

        pi_macro: pi_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp V &kp RIGHT_BRACKET>;
            label = "PI_MACRO";
        };

        pu_macro: pu_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_2 &kp RIGHT_BRACKET>;
            label = "PU_MACRO";
        };

        pe_macro: pe_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp RIGHT_BRACKET>;
            label = "PE_MACRO";
        };

        po_macro: po_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp RIGHT_BRACKET>;
            label = "PO_MACRO";
        };

        ge_macro: ge_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp APOSTROPHE &kp LEFT_BRACKET>;
            label = "GE_MACRO";
        };

        bo_macro: bo_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp LEFT_BRACKET>;
            label = "BO_MACRO";
        };

        be_macro: be_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp LEFT_BRACKET>;
            label = "BE_MACRO";
        };

        bu_macro: bu_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp NUMBER_2 &kp LEFT_BRACKET>;
            label = "BU_MACRO";
        };

        ze_macro: ze_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp P &kp LEFT_BRACKET>;
            label = "ZE_MACRO";
        };

        di_macro: di_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp A &kp LEFT_BRACKET>;
            label = "DI_MACRO";
        };
    };

    behaviors {
        // ★バックスペース専用設定：Spaceキーの&mtと同じリズムで連続入力が可能
        lt_bs: lt_bs {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_BACKSPACE";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <200>; 
            quick-tap-ms = <175>;    
            retro-tap;
            flavor = "balanced";
        };

        lt_scroll: lt_scroll {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SCROLL";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <100>;
            quick-tap-ms = <120>;
            flavor = "hold-preferred";
        };

        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;
            #binding-cells = <2>;
            tapping-term-ms = <100>;
            quick-tap-ms = <120>;
            flavor = "balanced";
        };

        lt_retro: lt_retro {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_RETRO";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <100>;
            quick-tap-ms = <120>;
            retro-tap;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Basic {
            bindings = <
// ==========================================================
// ★変更内容
// 1. GとZの長押しCtrlを削除
// 2. 左親指のLayer3切り替えをBackspaceへ移動
// 3. BackspaceをSpaceキーと同じ設定で連続入力可能に
// ==========================================================
&kp Q       &kp W         &kp E              &kp R          &kp T                                                                 &kp Y         &kp U      &kp I           &kp O    &kp P
&kp A       &kp S         &kp D              &mkp MB1       &kp G             &kp LEFT_ALT                &kp TAB                 &kp H         &mkp MB2   &lt_scroll 4 K  &kp L    &lt_retro 6 LEFT_BRACKET
&kp Z       &kp X         &kp C              &kp V          &kp B             &kp F                       &lt_retro 7 J           &kp N         &kp M      &kp COMMA       &kp DOT  &lt_retro 7 RIGHT_BRACKET
&kp LS(F5)  &kp LEFT_WIN  &kp LCTRL          &lt_bs 3 BACKSPACE  &mt LCTRL SPACE   &lt_retro 2 LANGUAGE_2      &lt_retro 1 LANGUAGE_1  &mt LSHIFT ENTER                                  &lt_retro 5 LS(LG(S))
            >;
        };

        FUNCTION {
            bindings = <
&kp NUMBER_1        &kp NUMBER_2         &kp NUMBER_3  &kp NUMBER_4  &kp N5                                         &kp NUMBER_6              &kp N7   &kp N8           &kp N9     &kp N0
&kp LEFT_SHIFT      &kp INTERNATIONAL_3  &kp EQUAL     &kp MINUS     &mt LCTRL QUESTION  &kp LEFT_ALT      &kp TAB  &mt LEFT_SHIFT SEMICOLON  &kp SQT  &kp NON_US_HASH  &kp SLASH  &lt_retro 8 INTERNATIONAL_1
&kp LS(Z)           &kp F2               &kp F3        &kp F4        &kp F5              &kp F6            &kp F7   &kp F8                    &kp F9   &kp F10          &kp F11    &lt_retro 9 F12
&kp LA(LC(DELETE))  &kp F1               &kp LCTRL     &kp DELETE    &kp LC(Z)           &kp LC(Y)         &trans   &trans                                                         &kp LC(LS(SEMI))
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE        &trans             &trans         &trans            &trans                                              &kp C_BRI_UP  &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &kp C_VOLUME_UP
&kp LEFT_SHIFT    &kp LG(C_AC_BACK)  &trans         &kp C_AC_FORWARD  &trans  &mt LCTRL LEFT_ALT      &mt LEFT_SHIFT TAB  &kp C_BRI_DN  &kp LEFT     &trans        &kp RIGHT      &kp C_VOLUME_DOWN
&kp LCTRL         &trans             &trans         &trans            &trans  &trans                  &trans              &trans        &kp HOME     &kp DOWN      &kp END        &kp C_MUTE
&kp LG(UP_ARROW)  &kp LG(LEFT)       &kp LG(RIGHT)  &trans            &trans  &trans                  &trans              &trans                                                  &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                               &kp LS(MINUS)  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0
&trans  &trans  &trans  &trans  &trans  &trans      &kp KP_ASTERISK  &kp KP_PLUS    &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_DOT
&trans  &trans  &trans  &trans  &trans  &trans      &kp KP_SLASH     &kp KP_MINUS   &kp NUMBER_7  &kp NUMBER_8  &kp N9        &kp INT3
&trans  &trans  &trans  &trans  &trans  &trans      &trans           &trans                                                   &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &bt BT_SEL 4  &trans          &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                    &trans
            >;
        };

        layer_6 {
            bindings = <
&da_macro  &de_macro  &trans     &zu_macro  &ga_macro                         &trans     &trans  &trans  &trans  &ze_macro
&di_macro  &do_macro  &zi_macro  &trans     &gi_macro  &trans         &trans  &gu_macro  &trans  &trans  &trans  &trans
&du_macro  &za_macro  &zo_macro  &bi_macro  &go_macro  &ba_macro      &trans  &trans     &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans     &trans     &trans         &trans  &trans                             &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans     &trans                         &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &pi_macro  &trans  &pa_macro      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans         &trans  &trans                          &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &bu_macro  &trans     &trans     &trans                      &trans  &trans     &trans  &trans  &trans
&trans  &trans     &be_macro  &bo_macro  &trans  &trans      &trans  &trans  &ge_macro  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans  &trans      &trans  &trans  &trans     &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans  &trans      &trans  &trans                             &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &pu_macro  &trans     &trans     &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans     &pe_macro  &po_macro  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans     &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
