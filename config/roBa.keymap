#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// ==========================================================
// グローバル設定
// ==========================================================

&trackball { scroll-layers = <4>; };

&mt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <35>;
    retro-tap;
};

&lt {
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <175>;
};

&kscan0 { debounce-period = <10>; };

/ {
    combos {
        compatible = "zmk,combos";
        timeout-ms = <80>;

        // --- システム・編集系 (既存) ---

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        select_all {
            bindings = <&kp LC(A)>;
            key-positions = <10 22>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <22 24>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <22 25>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <22 23>;
        };

        // --- 濁音・半濁音コンボ (既存) ---

