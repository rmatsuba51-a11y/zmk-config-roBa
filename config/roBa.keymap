            label = "VO";
        };

        // --- 追加: ZMKの厳格な記述ルール(スキーマ)に準拠した、Hold-Tap用の偽装引数つきマクロ ---

        m_colon_sp_tap: m_colon_sp_tap {
            compatible = "zmk,behavior-macro-one-param"; // 引数を受け取れるマクロ形式
            #binding-cells = <1>;
            bindings = <&kp LANGUAGE_2 &kp SPACE &kp SQT &kp SPACE &kp LANGUAGE_1>;
            label = "M_COLON_SP_TAP";
        };

        m_slash_sp_tap: m_slash_sp_tap {
            compatible = "zmk,behavior-macro-one-param"; // 引数を受け取れるマクロ形式
            #binding-cells = <1>;
            bindings = <&kp LANGUAGE_2 &kp SPACE &kp SLASH &kp SPACE &kp LANGUAGE_1>;
            label = "M_SLASH_SP_TAP";
        };
    };

    behaviors {
        lt_bs: lt_bs {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_BACKSPACE";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            retro-tap;
            flavor = "balanced";
        };

        lt_scroll: lt_scroll {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SCROLL";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            quick-tap-ms = <120>;
            flavor = "hold-preferred";
        };

        lt_retro: lt_retro {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_RETRO";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <100>;
            quick-tap-ms = <120>;
            retro-tap;
            flavor = "balanced";
        };

        // --- 追加: 引数付きマクロを受け付ける正しい形式の Hold-Tap ---

        mt_colon: mt_colon {
            compatible = "zmk,behavior-hold-tap";
            label = "MT_COLON";
            bindings = <&kp>, <&m_colon_sp_tap>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
        };

        lt_slash: lt_slash {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_SLASH";
            bindings = <&mo>, <&m_slash_sp_tap>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Basic {
            bindings = <
&kp Q             &kp W         &kp E      &kp R               &kp T                                                                   &kp Y                   &kp U      &kp I           &kp O    &kp P
&mt LEFT_SHIFT A  &kp S         &kp D      &mkp MB1            &kp G                 &kp LEFT_ALT                &kp LA(TAB)           &kp H                   &kp ENTER  &lt_scroll 4 K  &kp L    &lt_retro 6 LEFT_BRACKET
&kp Z             &kp X         &kp C      &kp V               &kp B                 &kp F                       &kp J                 &kp N                   &kp M      &kp COMMA       &kp DOT  &lt_retro 7 RIGHT_BRACKET
&kp LS(F5)        &kp LEFT_WIN  &kp LCTRL  &lt_bs 3 BACKSPACE  &mt LEFT_SHIFT SPACE  &lt_retro 2 LANGUAGE_2      &mt LEFT_CONTROL TAB  &lt_retro 1 LANGUAGE_1                                      &lt_retro 5 LS(LG(S))
            >;
        };

        // --- 変更: 左手親指の2つ目・3つ目に専用の Hold-Tap を配置 (最後に 0 というダミー引数を渡して整合性をとっています) ---

        FUNCTION {
            bindings = <
&kp NUMBER_1        &kp NUMBER_2   &kp NUMBER_3  &kp NUMBER_4  &kp N5                                             &kp NUMBER_6   &kp N7   &kp N8           &kp N9     &kp N0
&kp INT3            &kp EQUAL      &kp MINUS     &mkp MB2      &kp QUESTION            &trans             &trans  &kp SEMICOLON  &kp SQT  &kp NON_US_HASH  &kp SLASH  &lt_retro 8 INTERNATIONAL_1
&kp F1              &kp F2         &kp F3        &kp F4        &kp F5                  &kp F6             &kp F7  &kp F8         &kp F9   &kp F10          &kp F11    &lt_retro 9 F12
&kp LA(LC(DELETE))  &kp LG(LS(C))  &kp LG(V)     &kp DELETE    &mt_colon LEFT_SHIFT 0  &lt_slash 2 0      &trans  &trans                                              &kp LC(LS(SEMI))
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE      &trans             &trans         &trans            &trans                                              &kp C_BRI_UP   &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &kp C_VOLUME_UP
&kp LEFT_SHIFT  &kp LG(C_AC_BACK)  &trans         &kp C_AC_FORWARD  &trans  &mt LCTRL LEFT_ALT      &mt LEFT_SHIFT TAB  &kp C_BRI_DN   &kp LEFT     &trans        &kp RIGHT      &kp C_VOLUME_DOWN
&kp LCTRL       &kp LG(UP_ARROW)   &trans         &trans            &trans  &trans                  &trans              &trans         &kp HOME     &kp DOWN      &kp END        &kp C_MUTE
&kp LG(LEFT)    &kp LG(DOWN)       &kp LG(RIGHT)  &trans            &trans  &trans                  &m_paren_sp         &m_bracket_jp                                            &trans
            >;
        };

        layer_3 {
            bindings = <
&kp KP_NUMLOCK  &trans            &kp LS(LC(UP_ARROW))    &trans             &trans                               &kp LS(MINUS)  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N0
&trans          &kp LS(LC(LEFT))  &trans                  &kp LS(LC(RIGHT))  &trans  &trans      &kp KP_ASTERISK  &kp KP_PLUS    &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_DOT
&trans          &trans            &kp LS(LC(DOWN_ARROW))  &trans             &trans  &trans      &kp KP_SLASH     &kp KP_MINUS   &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp INT3
&trans          &trans            &trans                  &trans             &trans  &trans      &m_dquote        &m_squote                                       &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &bt BT_SEL 4  &trans          &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                    &trans
            >;
        };

        layer_6 {
            bindings = <
&da_macro  &de_macro  &trans     &zu_macro  &ga_macro                         &trans     &trans  &trans  &trans  &ze_macro
&di_macro  &do_macro  &zi_macro  &trans     &gi_macro  &trans         &trans  &gu_macro  &trans  &trans  &trans  &trans
&du_macro  &za_macro  &zo_macro  &bi_macro  &go_macro  &ba_macro      &trans  &trans     &trans  &trans  &trans  &trans
&trans     &trans     &trans     &trans     &trans     &trans         &trans  &trans                             &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans     &trans                         &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans         &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &pi_macro  &trans  &pa_macro      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans  &trans         &trans  &trans                          &trans
            >;
        };

        layer_8 {
            bindings = <
&trans  &bu_macro  &trans     &trans  &trans                      &trans  &trans     &trans  &trans  &trans
&trans  &be_macro  &bo_macro  &trans  &trans  &trans      &trans  &trans  &ge_macro  &trans  &trans  &trans
&trans  &trans     &trans     &trans  &trans  &trans      &trans  &trans  &trans     &trans  &trans  &trans
&trans  &trans     &trans     &trans  &trans  &trans      &trans  &trans                             &trans
            >;
        };

        layer_9 {
            bindings = <
&trans  &pu_macro  &trans     &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &pe_macro  &po_macro  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans     &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
