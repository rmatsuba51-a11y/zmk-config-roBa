#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
        };

        shift_tab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
        };

        muhennkann {
            bindings = <&to_layer_0 INT_MUHENKAN>;
            key-positions = <11 10>;
        };

        double_quotation {
            bindings = <&kp DOUBLE_QUOTES>;
            key-positions = <20 21>;
        };

        eq {
            bindings = <&kp EQUAL>;
            key-positions = <24 25>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        new_behavior: new_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "NEW_BEHAVIOR";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            hold-trigger-key-positions = <39>;
            tapping-term-ms = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Basic {
            bindings = <
&kp Q               &kp W         &kp E         &kp R      &kp T                                           &kp Y                &kp U  &kp I      &kp O    &kp P
&kp A               &kp S         &kp D         &kp F      &kp G     &lt 2 LA(TAB)        &kp DELETE       &kp H                &kp J  &lt 5 K    &kp L    &lt 6 LEFT_BRACKET
&kp Z               &kp X         &kp C         &kp V      &kp B     &kp SPACE            &kp BACKSPACE    &kp N                &kp M  &kp COMMA  &kp DOT  &kp RIGHT_BRACKET
&kp LC(LA(DELETE))  &kp LEFT_WIN  &kp LEFT_ALT  &kp ENTER  &mkp MB1  &mt LCTRL LANG1      &mt LCTRL LANG2  &new_behavior 1 MB2                             &kp LS(LG(S))
            >;
        };

        FUNCTION {
            bindings = <
&kp NUMBER_1  &kp NUMBER_2         &kp NUMBER_3  &kp NUMBER_4  &kp N5                                 &kp NUMBER_6    &kp N7   &kp N8             &kp N9     &kp N0
&trans        &kp INTERNATIONAL_3  &kp EQUAL     &kp MINUS     &trans     &kp LA(TAB)      &trans     &kp SEMICOLON   &kp SQT  &kp RIGHT_BRACKET  &kp SLASH  &kp INTERNATIONAL_1
&kp F1        &kp F2               &kp F3        &kp F4        &kp F5     &kp F6           &kp F7     &kp F8          &kp F9   &kp F10            &kp F11    &kp F12
&trans        &trans               &trans        &mkp LCLK     &kp ENTER  &mkp MB2         &kp LCTRL  &kp LEFT_SHIFT                                         &trans
            >;
        };

        ARROW {
            bindings = <
&kp ESCAPE  &trans  &trans  &trans  &trans                              &kp C_BRI_UP    &kp PAGE_UP  &kp UP_ARROW  &kp PAGE_DOWN  &kp C_VOLUME_UP
&trans      &trans  &trans  &trans  &trans  &kp LA(TAB)      &trans     &kp C_BRI_DN    &kp LEFT     &trans        &kp RIGHT      &kp C_VOLUME_DOWN
&trans      &trans  &trans  &trans  &trans  &trans           &trans     &trans          &kp HOME     &kp DOWN      &kp END        &trans
&trans      &trans  &trans  &trans  &trans  &trans           &kp LCTRL  &kp LEFT_SHIFT                                            &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                  &bt BT_CLR_ALL
            >;
        };
    };
};
